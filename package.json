{
  "name": "bonded",
  "version": "0.1.0",
  "description": "A mandate gate and reconciliation layer between AI agents and Binance",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bonded": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "start": "node --enable-source-maps dist/cli.js",
    "redteam": "node scripts/redteam.mjs",
    "verify": "node dist/cli.js verify"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "decimal.js": "^10.4.3",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "fast-check": "^3.23.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  },
  "license": "MIT"
}
