# Binance Spot Testnet credentials — https://testnet.binance.vision/
# NEVER commit real values. NEVER paste these into a chat.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Environment. BONDED refuses to start on anything but "testnet"
# unless BONDED_ALLOW_PROD=1 is also set.
BINANCE_API_ENV=testnet
BINANCE_SPOT_BASE_PATH=https://testnet.binance.vision

# Secret used to stamp authorised orders with an unforgeable clientOrderId.
# Generate with: openssl rand -hex 32
BONDED_HMAC_SECRET=

# Where the mandate and the hash-chained decision log live.
BONDED_MANDATE_PATH=./data/mandate.json
BONDED_DECISION_LOG_PATH=./data/decisions.jsonl

# info | debug | warn | error
BONDED_LOG_LEVEL=info
