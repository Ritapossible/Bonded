# Binance Spot Testnet credentials — https://testnet.binance.vision/
# NEVER commit real values. NEVER paste these into a chat.
#
# BONDED reads this file at startup, from the working directory or from its own
# installation directory. Anything already set in the real environment wins over it, so
# an explicit `BINANCE_API_ENV=prod` can never be silently overridden by a stale file.
#
# An agent that launches BONDED from a desktop app may run it from neither directory.
# For those clients, put these in the MCP config's `env` block instead.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Environment. BONDED refuses to start on anything but "testnet"
# unless BONDED_ALLOW_PROD=1 is also set. Both URLs below are checked against an
# allowlist of Binance hostnames and must agree with this value.
BINANCE_API_ENV=testnet
BINANCE_SPOT_BASE_PATH=https://testnet.binance.vision

# Secret used to stamp authorised orders with an unforgeable clientOrderId.
# Generate with: openssl rand -hex 32
BONDED_HMAC_SECRET=

# Where the mandate and the hash-chained decision log live.
BONDED_MANDATE_PATH=./data/mandate.json
BONDED_DECISION_LOG_PATH=./data/decisions.jsonl

# info | debug | warn | error
BONDED_LOG_LEVEL=info

# User data stream endpoint. The reconciler subscribes here for executionReport events.
BINANCE_STREAM_BASE_PATH=wss://stream.testnet.binance.vision/ws

# How often the polling backstop re-reads order history, in milliseconds.
BONDED_POLL_INTERVAL_MS=15000

# Owner console port. Always bound to 127.0.0.1. Set to 0 to disable.
BONDED_CONSOLE_PORT=7391

# Permit trading when only the polling backstop is delivering.
# Binance's REST order history needs a symbol, so the poller only covers the symbols
# it is given; the account-wide user data stream is what makes detection complete.
# Leave at 0 to stop trading when the stream is down.
BONDED_ALLOW_PARTIAL_AUDIT=0

# Extra symbols the poller watches, comma separated, beyond the mandate's own.
# Naming the pairs the account actually holds narrows the poller's blind spot.
BONDED_WATCH_SYMBOLS=

# Where reference prices come from: "rest" or "binance-cli".
#
# "binance-cli" routes this one read through @binance/binance-cli, Binance's own Agent OS
# tooling, which reads the same variables as this file and supports testnet. Orders are
# always signed by BONDED itself: the gate has to control the exact query string it signs
# and stamp a clientOrderId on every order, so the write path never leaves the process.
#
# "rest" is the default because it has the fewest moving parts. A source that spawns a
# process can fail in ways a fetch cannot, and either way it fails closed — an
# unavailable price denies the order rather than sizing it against a guess.
BONDED_PRICE_SOURCE=rest

# How far back the first poll reaches, in milliseconds, to catch orders placed while
# BONDED was down. Default 24 hours.
#
# A fresh instance with an EMPTY decision log should not inherit a day of history it has
# no records for: every order legitimately authorised in that window reads as
# UNKNOWN_AUTHENTIC (valid tag, no matching record) and burns the bond on startup. Lower
# this when starting clean against an account that has traded recently.
BONDED_LOOKBACK_MS=86400000
